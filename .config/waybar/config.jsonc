{
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 6,

    "modules-left": [
        "custom/arch",
        "clock"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "pulseaudio",
        "custom/bluetooth",
        "memory",
        "cpu",
        "tray",
        "custom/power"
    ],

    // Левый логотип
    "custom/arch": {
        "format": "  ",
        "tooltip-format": "ЛКМ: Меню • ПКМ: Темы • СКМ: Обои",
        "on-click": "fuzzel",
        "on-click-right": "~/.config/waybar/scripts/theme-switcher.sh",
        "on-click-middle": "~/.config/hypr/scripts/wallpaper-picker.py"
    },

    // Часы слева
    "clock": {
        "format": " {:%H:%M}",
        "format-alt": " {:%A, %d %B}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    // Воркспейсы для Hyprland
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },

    // Bluetooth
    "custom/bluetooth": {
        "format": "󰂯",
        "tooltip-format": "Bluetooth",
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.py",
        "tooltip": true
    },

    // Звук
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " Muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol || pavucontrol-qt",
        "scroll-step": 2
    },

    // ОЗУ
    "memory": {
        "interval": 3,
        "format": " {used:0.1f}G",
        "tooltip-format": "ОЗУ: {used:0.1f}G / {total:0.1f}G",
        "on-click": "kitty -e btop"
    },

    // ЦП
    "cpu": {
        "interval": 2,
        "format": " {usage}%",
        "tooltip": false,
        "on-click": "kitty -e btop"
    },

    // Трей
    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    // Кнопка питания
    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "pkill wlogout || wlogout -p layer-shell"
    }
}
