/* Bluetooth Menu — transparent glass with white glow */
/* Matches Waybar dark glass theme */

configuration {
    show-icons:     false;
}

* {
    font:            "JetBrainsMono NF Bold 11";
    background:      rgba(20, 20, 24, 0.75);
    background-alt:  rgba(30, 30, 36, 0.85);
    foreground:      #e0e0e0;
    selected:        rgba(255, 255, 255, 0.18);
    selected-text:   #ffffff;
    active:          rgba(255, 255, 255, 0.12);
    urgent:          #f7768e;
    border-glow:     rgba(255, 255, 255, 0.35);
    border-soft:     rgba(255, 255, 255, 0.10);
}

window {
    transparency:       "real";
    location:           north;
    anchor:             north;
    fullscreen:         false;
    width:              380px;
    x-offset:           0px;
    y-offset:           52px;

    enabled:            true;
    margin:             0px;
    padding:            0px;
    border:             1px solid;
    border-radius:      14px;
    border-color:       @border-glow;
    cursor:             "default";
    background-color:   @background;
}

mainbox {
    enabled:            true;
    spacing:            8px;
    margin:             0px;
    padding:            18px;
    border:             0px solid;
    border-radius:      0px;
    background-color:   transparent;
    children:           [ "inputbar", "listview" ];
}

inputbar {
    enabled:            true;
    spacing:            8px;
    margin:             0px;
    padding:            0px;
    border:             0px solid;
    background-color:   transparent;
    text-color:         @foreground;
    children:           [ "textbox-prompt-colon", "prompt" ];
}

textbox-prompt-colon {
    enabled:            true;
    expand:             false;
    padding:            10px 12px;
    border-radius:      10px;
    str:                "󰂯";
    background-color:   rgba(255, 255, 255, 0.10);
    text-color:         @foreground;
}

prompt {
    enabled:            true;
    padding:            10px 14px;
    border-radius:      10px;
    background-color:   rgba(255, 255, 255, 0.06);
    text-color:         @foreground;
}

listview {
    enabled:            true;
    columns:            1;
    lines:              8;
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
    layout:             vertical;
    reverse:            false;
    fixed-height:       false;
    fixed-columns:      true;

    spacing:            4px;
    margin:             0px;
    padding:            0px;
    border:             0px solid;
    background-color:   transparent;
    text-color:         @foreground;
    cursor:             "default";
}

element {
    enabled:            true;
    spacing:            8px;
    margin:             0px;
    padding:            10px 14px;
    border:             0px solid;
    border-radius:      10px;
    background-color:   transparent;
    text-color:         @foreground;
    cursor:             pointer;
}

element normal.normal {
    background-color:   transparent;
    text-color:         @foreground;
}

element normal.active {
    background-color:   @active;
    text-color:         @selected-text;
}

element selected.normal {
    background-color:   @selected;
    text-color:         @selected-text;
    border:             1px solid;
    border-color:       @border-soft;
}

element selected.active {
    background-color:   @selected;
    text-color:         @selected-text;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    cursor:             inherit;
    vertical-align:     0.5;
    horizontal-align:   0.0;
}
