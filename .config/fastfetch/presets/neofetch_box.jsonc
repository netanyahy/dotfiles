{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "custom",
      "key": "╭───────────╮"
    },
    {
      "type": "title",
      "key": "│  user    │",
      "format": "{user-name}"
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 uptime  │"
    },
    {
      "type": "os",
      "key": "│  distro  │"
    },
    {
      "type": "kernel",
      "key": "│  kernel  │"
    },
    {
      "type": "wm",
      "key": "│  wm      │"
    },
    {
      "type": "terminal",
      "key": "│  term    │"
    },
    {
      "type": "shell",
      "key": "│  shell   │"
    },
    {
      "type": "cpu",
      "key": "│ 󰍛 cpu     │"
    },
    {
      "type": "memory",
      "key": "│  memory  │"
    },
    {
      "type": "custom",
      "key": "├───────────┤"
    },
    {
      "type": "colors",
      "key": "│  colors  │",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "key": "╰───────────╯"
    }
  ]
}
